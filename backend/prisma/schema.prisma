generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users  User[]
  assets Asset[]
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("viewer")
  active       Boolean  @default(true)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Asset {
  id          Int      @id @default(autoincrement())
  deviceId    String   @unique
  name        String
  description String?
  active      Boolean  @default(true)

  temperatureMinC          Float?
  temperatureMaxC          Float?
  temperatureAlertsEnabled Boolean @default(false)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  telemetry Telemetry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Telemetry {
  id          Int      @id @default(autoincrement())
  deviceId    String
  temperature Float
  latitude    Float?
  longitude   Float?
  altitude    Float?
  speedKph    Float?
  movementStatus String?

  // Momento REAL en que el dispositivo capturo la lectura.
  // Para GPS valido viene del UTC de GNSS.
  recordedAt DateTime?

  // true = lectura historica reenviada desde la cola SD.
  // Nunca debe reemplazar el estado/ubicacion "en vivo".
  isBackfill Boolean @default(false)

  // Momento en que Maverick recibio el paquete.
  receivedAt DateTime @default(now())

  assetId Int?
  asset   Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([deviceId])
  @@index([assetId])
  @@index([receivedAt])
  @@index([recordedAt])
  @@index([isBackfill])
  @@index([assetId, recordedAt])
}
