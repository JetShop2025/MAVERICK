generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  assets     Asset[]
  dispatches Dispatch[]
}

model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  passwordHash String
  name         String
  role         String  @default("viewer")
  active       Boolean @default(true)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Asset {
  id          Int     @id @default(autoincrement())
  deviceId    String  @unique
  name        String
  description String?
  active      Boolean @default(true)

  temperatureMinC          Float?
  temperatureMaxC          Float?
  temperatureAlertsEnabled Boolean @default(false)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  telemetry  Telemetry[]
  dispatches Dispatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Telemetry {
  id             Int     @id @default(autoincrement())
  deviceId       String
  temperature    Float
  latitude       Float?
  longitude      Float?
  altitude       Float?
  speedKph       Float?
  movementStatus String?

  // Momento REAL en que el dispositivo capturo la lectura.
  // Para GPS valido viene del UTC de GNSS.
  recordedAt DateTime?

  // true = lectura historica reenviada desde la cola SD.
  // Nunca debe reemplazar el estado/ubicacion "en vivo".
  isBackfill Boolean @default(false)

  // Momento en que Maverick recibio el paquete.
  receivedAt DateTime @default(now())

  assetId Int?
  asset   Asset? @relation(fields: [assetId], references: [id])

  @@index([deviceId])
  @@index([assetId])
  @@index([receivedAt])
  @@index([recordedAt])
  @@index([isBackfill])
  @@index([assetId, recordedAt])
}

enum DispatchStatus {
  ASSIGNED
  EN_ROUTE_TO_PICKUP
  AT_PICKUP
  LOADED
  IN_TRANSIT
  AT_DELIVERY
  DELIVERED
  CANCELLED
}

model Dispatch {
  id         Int            @id @default(autoincrement())
  loadNumber String
  status     DispatchStatus @default(ASSIGNED)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  assetId Int?
  asset   Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  pickupName        String
  pickupAddress     String
  pickupLatitude    Float?
  pickupLongitude   Float?
  pickupScheduledAt DateTime?

  deliveryName        String
  deliveryAddress     String
  deliveryLatitude    Float?
  deliveryLongitude   Float?
  deliveryScheduledAt DateTime?

  commodity       String?
  referenceNumber String?

  temperatureSetpointC Float?
  temperatureMinC      Float?
  temperatureMaxC      Float?

  notes       String?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusEvents DispatchStatusEvent[]

  @@unique([companyId, loadNumber])
  @@index([companyId, status])
  @@index([assetId, status])
  @@index([pickupScheduledAt])
  @@index([deliveryScheduledAt])
}

model DispatchStatusEvent {
  id        Int            @id @default(autoincrement())
  status    DispatchStatus
  notes     String?
  createdAt DateTime       @default(now())

  dispatchId Int
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  @@index([dispatchId, createdAt])
}
