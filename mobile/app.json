{
  "expo": {
    "name": "MAVDRIVE",
    "slug": "mavapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mavtrack.driver",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "MAVDRIVE uses your location to send your truck position to MAVTRACK while tracking is active.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "MAVDRIVE uses background location so MAVTRACK can continue receiving your truck position when the screen is locked or another app is open.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "MAVDRIVE"
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ],
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults"
          }
        ]
      }
    },
    "android": {
      "package": "com.mavtrack.driver",
      "adaptiveIcon": {
        "backgroundColor": "#07111F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MAVDRIVE uses your location to share your truck position with your fleet while tracking is active.",
          "locationAlwaysAndWhenInUsePermission": "MAVDRIVE shares your truck position with your fleet during active tracking, including when the screen is locked or another app is open.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "photosPermission": "MAVDRIVE lets you select photos to attach to your assigned load.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9344a122-6887-4db2-a18f-1abb708c91bd"
      }
    }
  }
}
